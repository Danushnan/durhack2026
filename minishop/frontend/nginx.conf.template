resolver ${DNS_RESOLVER} valid=5s ipv6=off;
map $http_x_request_id $correlation_id {
    default $request_id;
    "~*^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" $http_x_request_id;
}
log_format shop escape=json '{"event":"proxy_access","service":"minishop-web","request_id":"$correlation_id","method":"$request_method","route":"$uri","status":$status,"duration_seconds":$request_time,"upstream":"$upstream_addr","upstream_status":"$upstream_status"}';
upstream products {zone products 64k; server product-api${UPSTREAM_SUFFIX}:8000 resolve;}
upstream cart {zone cart 64k; server cart-api${UPSTREAM_SUFFIX}:8000 resolve;}
upstream checkout {zone checkout 64k; server checkout-api${UPSTREAM_SUFFIX}:8000 resolve;}
server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;
    access_log /dev/stdout shop;
    client_max_body_size 16k;
    proxy_connect_timeout 2s;
    proxy_read_timeout 50s;
    # Never automatically replay a mutating checkout at the proxy.
    proxy_next_upstream off;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $correlation_id;
    proxy_set_header X-Source-Service minishop-web;
    proxy_hide_header X-Request-ID;
    add_header X-Request-ID $correlation_id always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    location = /health/live {access_log off; return 200 'ok';}
    location = /health/ready {access_log off; return 200 'ready';}
    location /api/products {proxy_pass http://products/products;}
    location /api/carts/ {proxy_pass http://cart/carts/;}
    location /api/checkout/ {proxy_pass http://checkout/checkout/;}
    location /api/orders/ {proxy_pass http://checkout/orders/;}
    location /api/ {return 404;}
    location /images/ {try_files $uri =404; expires 1d;}
    location / {try_files $uri $uri/ /index.html;}
}
