{
  "schema_version": 1,
  "application": "minishop",
  "namespace": "minishop",
  "discovery_label": {"app.kubernetes.io/part-of": "kubeverse-demo"},
  "container": "workload",
  "resource_id_format": "{namespace}/{deployment}",
  "components": [
    {"id":"minishop-web","source":"frontend/","deployment":"minishop-web","service":"minishop-web","port":8080,"type":"frontend","dependencies":["product-api","cart-api","checkout-api"]},
    {"id":"product-api","source":"services/products/","deployment":"product-api","service":"product-api","port":8000,"type":"api","dependencies":["postgres"]},
    {"id":"cart-api","source":"services/cart/","deployment":"cart-api","service":"cart-api","port":8000,"type":"api","dependencies":["product-api","redis"]},
    {"id":"checkout-api","source":"services/checkout/","deployment":"checkout-api","service":"checkout-api","port":8000,"type":"api","dependencies":["cart-api","product-api","payment-api","postgres"]},
    {"id":"payment-api","source":"services/payments/","deployment":"payment-api","service":"payment-api","port":8000,"type":"simulated-payment","dependencies":[]},
    {"id":"postgres","source":"db/","deployment":"postgres","service":"postgres","port":5432,"type":"database","persistent_volume_claim":"postgres-data","dependencies":[]},
    {"id":"redis","source":"services/cart/","deployment":"redis","service":"redis","port":6379,"type":"cache","persistent_volume_claim":"redis-data","dependencies":[]}
  ],
  "shared_source": "services/common/",
  "notes": ["Known dependencies describe code paths; request logs describe measured activity only.", "PostgreSQL and Redis use single-replica Recreate Deployments to match the existing KubeVerse pod ownership resolver.", "Redis is an upstream image configured by k8s/02-data.yaml; services/cart/ owns its basket schema."]
}
